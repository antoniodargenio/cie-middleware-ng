#!/bin/sh
# Versione MAJOR.MINOR.PATCH.BUILD: qui sale solo BUILD (mai azzerato); major/minor/patch con ./bump-version.sh
# Incrementa automaticamente l'ultima cifra della versione (version.txt) a ogni commit
# e la propaga in e Setup/CIE-Middleware-NG.nsi.
cd "$(git rev-parse --show-toplevel)" || exit 1
cur=$(tr -d '\r\n ' < version.txt)
base=${cur%.*}
rev=${cur##*.}
new="$base.$((rev + 1))"
printf '%s\n' "$new" > version.txt
sed -b -i "s/\(PRODUCT_VERSION \"\)[0-9.]*\(\"\)/\1$new\2/" Setup/CIE-Middleware-NG.nsi
sed -b -i "s/\(ModuleVersion        = '\)[0-9.]*\('\)/\1$new\2/" PowerShell/CIE-Middleware-NG/CIE-Middleware-NG.psd1
python .githooks/set-rc-version.py "$new" || python3 .githooks/set-rc-version.py "$new"
git add CSP/res/CIEPKI.rc version.txt Setup/CIE-Middleware-NG.nsi PowerShell/CIE-Middleware-NG/CIE-Middleware-NG.psd1
echo "Versione: $cur -> $new"
