<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CIEID.Wpf</RootNamespace>
    <AssemblyName>CIE-Middleware-NG</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VersionText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\version.txt').Trim())</VersionText>
    <Version>$(VersionText)</Version>
    <Product>CIE Middleware NG (build non ufficiale)</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CIEID.Core\CIEID.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Strumento di anteprima PDF (MuPDF, vedi THIRD-PARTY-NOTICES.md) e font della firma grafica -->
    <Content Include="Tools\mutool.exe" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Allura-Regular.ttf" />
    <Resource Include="Assets/app.ico" />
  </ItemGroup>
</Project>
