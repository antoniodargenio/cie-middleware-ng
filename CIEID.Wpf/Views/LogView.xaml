<UserControl x:Class="CIEID.Wpf.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="Log"/>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Cartella dei log"/>
                <TextBlock Text="{Binding Directory}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Apri cartella" Command="{Binding OpenCommand}"/>
                    <Button Content="Esporta in zip" Command="{Binding ExportCommand}" Margin="8,0,0,0"/>
                    <Button Content="Elimina log" Style="{StaticResource DangerButton}" Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
