<UserControl x:Class="CIEID.Wpf.Views.SignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid AllowDrop="True" Drop="OnDrop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Title}" Text="Firma"/>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Documento"/>
                        <Button Content="Scegli file…" Command="{Binding BrowseCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Carta"/>
                        <ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" DisplayMemberPath="Owner" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Label}" Text="Formato" Margin="0,12,0,0"/>
                        <RadioButton Content="PAdES (PDF)" IsChecked="{Binding Pades}" IsEnabled="{Binding IsPdf}" Margin="0,6,0,0"/>
                        <RadioButton x:Name="CadesRadio" Content="CAdES (.p7m)" Margin="0,4,0,0" Checked="Cades_Checked"/>
                        <CheckBox Content="Firma grafica visibile" IsChecked="{Binding Graphic}" IsEnabled="{Binding Pades}" Margin="0,10,0,0"
                                  Visibility="{Binding IsPdf, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="La tua firma grafica"/>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Height="70" Margin="0,6,0,0">
                            <Image Source="{Binding SignatureImage}" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Crea o disegna…" Command="{Binding CreateSignatureCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
                            <Button Content="Carica immagine…" Command="{Binding ImportSignatureCommand}" Margin="0,0,8,4"/>
                            <Button Content="Ripristina" Command="{Binding ResetSignatureCommand}" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="PIN (ultime 4 cifre)"/>
                        <PasswordBox x:Name="PinBox" MaxLength="8" PasswordChanged="PinBox_Changed" Margin="0,6,0,0"/>
                        <Button Content="Firma" Style="{StaticResource PrimaryButton}" Command="{Binding SignCommand}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,12,0,16" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Anteprima e posizionamento della firma grafica -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding Graphic, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Pagina" VerticalAlignment="Center"/>
                    <Button Content="‹" Click="PrevPage" Padding="10,2" Margin="8,0,0,0"/>
                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                        <Run Text="{Binding Page, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding PageCount, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="›" Click="NextPage" Padding="10,2"/>
                    <TextBlock Text="Trascina il riquadro per spostarlo, usa l'angolo per ridimensionarlo" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Grid x:Name="PageHost">
                        <Image x:Name="PageImg" Source="{Binding PageImage}" Stretch="None"/>
                        <Canvas x:Name="Overlay" Background="Transparent"
                                Width="{Binding ActualWidth, ElementName=PageImg}" Height="{Binding ActualHeight, ElementName=PageImg}"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border x:Name="Box" BorderBrush="{StaticResource Primary}" BorderThickness="2" Background="#331F7A4D" Cursor="SizeAll"
                                    MouseLeftButtonDown="Box_Down" MouseMove="Box_Move" MouseLeftButtonUp="Box_Up">
                                <Grid>
                                    <Image Source="{Binding SignatureImage}" Stretch="Fill" IsHitTestVisible="False"/>
                                    <Thumb x:Name="Grip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Cursor="SizeNWSE" DragDelta="Grip_Delta">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource Primary}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
