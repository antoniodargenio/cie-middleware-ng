<Window x:Class="CIEID.Wpf.Views.SignatureEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crea la tua firma grafica" Width="560" Height="520" MinWidth="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <TabItem Header="Testo">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Label}" Text="Testo della firma"/>
                    <TextBox x:Name="TextBox" Margin="0,6,0,0" Padding="4" TextChanged="OnTextOptionChanged"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Carattere"/>
                            <ComboBox x:Name="FontBox" Margin="0,6,0,0" SelectionChanged="OnTextOptionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Maiuscole"/>
                            <ComboBox x:Name="CaseBox" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="OnTextOptionChanged">
                                <ComboBoxItem Content="Iniziali maiuscole"/>
                                <ComboBoxItem Content="TUTTO MAIUSCOLO"/>
                                <ComboBoxItem Content="tutto minuscolo"/>
                                <ComboBoxItem Content="Come digitato"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Label}" Text="Anteprima" Margin="0,16,0,0"/>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Height="130" Margin="0,6,0,0">
                        <Image x:Name="TextPreview" Stretch="Uniform" Margin="6"/>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Disegna">
                <StackPanel Margin="12">
                    <TextBlock Text="Firma con il mouse, il touchpad o una penna nel riquadro." Foreground="{StaticResource InkSoft}"/>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Height="220" Margin="0,8,0,0">
                        <InkCanvas x:Name="Ink" Background="White"/>
                    </Border>
                    <Button Content="Cancella" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnClearInk"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Annulla" IsCancel="True" Padding="16,6"/>
            <Button Content="Usa questa firma" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="16,6" Margin="8,0,0,0" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
