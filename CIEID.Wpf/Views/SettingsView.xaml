<UserControl x:Class="CIEID.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Title}" Text="Impostazioni"/>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Marca temporale"/>
                    <CheckBox Content="Applica la marca temporale alle firme" IsChecked="{Binding TimestampEnabled}" Margin="0,6,0,6"/>
                    <TextBlock Text="Server predefinito" Foreground="{StaticResource InkSoft}"/>
                    <TextBlock Text="{Binding TimestampUrl}" Margin="0,0,0,8"/>
                    <TextBlock Text="Server personalizzato (facoltativo)" Foreground="{StaticResource InkSoft}"/>
                    <TextBox Text="{Binding TimestampCustomUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Utente" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding TsaUser}"/>
                    <TextBlock Text="Password" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <PasswordBox x:Name="TsaPass" PasswordChanged="TsaPass_Changed" MaxLength="64"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Proxy"/>
                    <TextBlock Text="Indirizzo" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding ProxyUrl}"/>
                    <TextBlock Text="Porta" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding ProxyPort}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Text="Utente" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding ProxyUser}"/>
                    <TextBlock Text="Password" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <PasswordBox x:Name="ProxyPass" PasswordChanged="ProxyPass_Changed" MaxLength="64"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Livelli di log"/>
                    <TextBlock Text="Applicazione" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding AppLevel}" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock Text="Libreria CIEPKI-NG" Foreground="{StaticResource InkSoft}" Margin="0,6,0,0"/>
                    <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding LibLevel}" Width="160" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Button Content="Salva" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,16"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
