<Application x:Class="CIEID.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CIEID.Wpf.ViewModels"
             xmlns:v="clr-namespace:CIEID.Wpf.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <DataTemplate DataType="{x:Type vm:CardsViewModel}"><v:CardsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SignViewModel}"><v:SignView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VerifyViewModel}"><v:VerifyView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewModel}"><v:LogView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
