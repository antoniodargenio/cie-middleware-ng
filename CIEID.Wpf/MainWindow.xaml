<Window x:Class="CIEID.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIE Middleware NG" Width="1040" Height="720" MinWidth="860" MinHeight="600"
        Background="{StaticResource Canvas}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Barra laterale -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryDark}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,16,20">
                    <TextBlock Text="CIE Middleware NG" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="build non ufficiale" Foreground="#9CC7AE" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,12,16,16">
                    <TextBlock x:Name="VersionLabel" Foreground="#9CC7AE" FontSize="11" />
                    <TextBlock Text="Non affiliato a IPZS o al Ministero dell'Interno." Foreground="#7FA992" FontSize="10.5" Margin="0,4,0,0" />
                </StackPanel>
                <ListBox x:Name="Nav" ItemsSource="{Binding Items}" SelectedItem="{Binding Current}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenuto -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="32,26,32,20">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,6" Click="HelpToggle_Click"
                        Content="? Aiuto" />
                <ContentControl Content="{Binding Current}" />
            </DockPanel>
        </ScrollViewer>

        <!-- Aiuto contestuale -->
        <Border x:Name="HelpPanel" Grid.Column="2" Width="280" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed" Padding="20">
            <StackPanel>
                <TextBlock Text="{Binding Current.Title, StringFormat='Aiuto: {0}'}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Current.Help}" Margin="0,10,0,0" Foreground="{StaticResource InkSoft}" LineHeight="20" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
